-- palofsc - Rayfield GUI script for Roblox
-- Features: WalkSpeed control, ESP (Chams), and Noclip
-- Author: Krypt
-- Note: This script uses the Rayfield library.

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Exploit Control Panel",
   LoadingTitle = "Initializing Systems",
   LoadingSubtitle = "Made by Krypt",
})

local Tab = Window:CreateTab("Movement & ESP", "move")

-- WalkSpeed Section
local WalkSpeedValue = 25
Tab:CreateButton({
   Name = "Set WalkSpeed to 25",
   Callback = function()
      local player = game.Players.LocalPlayer
      if player.Character and player.Character:FindFirstChild("Humanoid") then
         local hrp = player.Character:FindFirstChild("HumanoidRootPart")
         if hrp then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
         end
         player.Character.Humanoid.WalkSpeed = WalkSpeedValue
      end
   end,
})

-- Noclip Section
local Noclipping = nil
Tab:CreateToggle({
   Name = "Noclip",
   CurrentValue = false,
   Callback = function(Value)
      if Value then
         Noclipping = game:GetService("RunService").Stepped:Connect(function()
            if game.Players.LocalPlayer.Character then
               for _, v in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do
                  if v:IsA("BasePart") then
                     v.CanCollide = false
                  end
               end
            end
         end)
      else
         if Noclipping then
            Noclipping:Disconnect()
            Noclipping = nil
         end
      end
   end,
})

-- ESP Section
Tab:CreateToggle({
   Name = "Enable ESP",
   CurrentValue = false,
   Callback = function(Value)
      if Value then
         for _, v in pairs(game.Players:GetPlayers()) do
            if v ~= game.Players.LocalPlayer and v.Character then
               local highlight = Instance.new("Highlight")
               highlight.Name = "ESP_Highlight"
               highlight.Parent = v.Character
               highlight.FillColor = Color3.fromRGB(255, 0, 0)
            end
         end
      else
         for _, v in pairs(game.Players:GetPlayers()) do
            if v.Character and v.Character:FindFirstChild("ESP_Highlight") then
               v.Character.ESP_Highlight:Destroy()
            end
         end
      end
   end,
})
