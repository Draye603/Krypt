WinBtn.Position = UDim2.new(0.06, 0, 0.1, 0)
WinBtn.Text = "Instant Win"
WinBtn.MouseButton1Click:Connect(InstantWin)

local WaterBtn = Instance.new("TextButton", Frame)
WaterBtn.Size = UDim2.new(0, 130, 0, 30)
